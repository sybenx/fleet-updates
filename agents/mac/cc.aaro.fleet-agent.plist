<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- install.sh fills in __AGENT__ and __HOME__. StartInterval runs missed while the Mac slept
     fire once at wake. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cc.aaro.fleet-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>__AGENT__</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOMEBREW_NO_AUTO_UPDATE</key>
    <string>1</string>
  </dict>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/fleet-agent.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/fleet-agent.out.log</string>
</dict>
</plist>
