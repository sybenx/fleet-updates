# The agent in Dockge mode: the docker CLI (with compose and buildx) plus the agent binary.
#   docker build -f deploy/Dockerfile.dockge-agent -t fleet-dockge-agent .
FROM golang:1.24-alpine AS build
WORKDIR /src
COPY agent ./agent
RUN cd agent && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o /fleet-agent .

FROM docker:cli
COPY --from=build /fleet-agent /usr/local/bin/fleet-agent
ENTRYPOINT ["fleet-agent"]
CMD ["dockge"]
